{
  "name": "proofroute",
  "version": "0.1.0",
  "description": "A CLI-first model router that acts as a transparent OpenAI-compatible proxy and proves model-choice savings in the terminal.",
  "type": "module",
  "bin": {
    "proofroute": "./bin/proofroute.js",
    "proofroute-classifier": "./bin/proofroute-classifier.js"
  },
  "scripts": {
    "start": "node ./bin/proofroute.js",
    "prove": "node ./bin/proofroute.js prove",
    "smoke": "node ./bin/proofroute.js smoke",
    "smoke:proxy": "node ./bin/proofroute.js smoke --proxy",
    "test": "node --test",
    "check": "find bin src test examples -name '*.js' -print -exec node --check {} \\;"
  },
  "keywords": [
    "llm",
    "router",
    "proxy",
    "openai",
    "ollama",
    "cli",
    "avc",
    "vibe-coding"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
