{
  "name": "llm-router",
  "version": "0.1.0",
  "description": "A CLI-first AVC LLM router that acts as a transparent OpenAI-compatible proxy and proves model-choice savings in the terminal.",
  "type": "module",
  "bin": {
    "llm-router": "./bin/llm-router.js"
  },
  "scripts": {
    "start": "node ./bin/llm-router.js",
    "test": "node --test",
    "check": "node --check ./bin/llm-router.js && find src test -name '*.js' -print -exec node --check {} \\;"
  },
  "keywords": [
    "llm",
    "router",
    "proxy",
    "openai",
    "ollama",
    "cli",
    "avc",
    "vibe-coding"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
