{
  "name": "proofroute",
  "version": "0.1.0",
  "description": "CLI-first, zero-dependency OpenAI-compatible LLM router/proxy that routes each prompt to the cheapest fast-enough local or cloud model and proves speed, savings, and prompt-free privacy in your terminal.",
  "type": "module",
  "homepage": "https://github.com/Lling0000/proofroute#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lling0000/proofroute.git"
  },
  "bugs": {
    "url": "https://github.com/Lling0000/proofroute/issues"
  },
  "bin": {
    "proofroute": "./bin/proofroute.js",
    "proofroute-classifier": "./bin/proofroute-classifier.js"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "scripts",
    "docs",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "start": "node ./bin/proofroute.js",
    "demo": "node ./bin/proofroute.js demo",
    "profile": "node ./bin/proofroute.js profile",
    "profile:public:check": "node ./bin/proofroute.js profile --check-public",
    "profile:github:check": "node ./bin/proofroute.js profile --check-github",
    "profile:github:sync": "node ./bin/proofroute.js profile --sync-github",
    "launch": "node ./bin/proofroute.js launch",
    "launch:core": "node ./bin/proofroute.js launch --core",
    "launch:public": "node ./bin/proofroute.js launch --check-public",
    "launch:json": "node ./bin/proofroute.js launch --json",
    "launch:artifact": "node ./bin/proofroute.js launch --require-artifact-evidence --artifact-evidence classifier-linear-evidence.json --max-evidence-age-hours 24",
    "launch:strict": "node ./bin/proofroute.js launch --require-evidence --evidence classifier-evidence.json --max-evidence-age-hours 24",
    "release:pack": "node ./bin/proofroute.js release --out proofroute-release-pack --check-github",
    "release:core": "node ./bin/proofroute.js release --core --out proofroute-release-pack",
    "release:artifact": "node ./bin/proofroute.js release --core --require-artifact-evidence --artifact-evidence classifier-linear-evidence.json --max-evidence-age-hours 24 --out proofroute-release-pack",
    "release:pack:local": "node ./bin/proofroute.js release --core --json",
    "release:public:preflight": "node ./bin/proofroute.js release --preflight --core --check-public",
    "release:strict:preflight": "node ./bin/proofroute.js release --preflight --require-evidence --evidence classifier-evidence.json --max-evidence-age-hours 24",
    "release:strict": "node ./bin/proofroute.js release --out proofroute-release-pack --check-github --require-evidence --evidence classifier-evidence.json --max-evidence-age-hours 24",
    "release:npm:dry-run": "npm pack --json --dry-run",
    "share": "node ./bin/proofroute.js share",
    "share:markdown": "node ./bin/proofroute.js share --markdown",
    "share:svg": "node ./bin/proofroute.js share --svg --out docs/proofroute-terminal.svg",
    "prove": "node ./bin/proofroute.js prove",
    "privacy": "node ./bin/proofroute.js privacy",
    "smoke": "node ./bin/proofroute.js smoke",
    "smoke:proxy": "node ./bin/proofroute.js smoke --proxy",
    "doctor": "node ./bin/proofroute.js doctor",
    "doctor:hardware": "node ./bin/proofroute.js doctor --strict-hardware",
    "classifier:linear": "sh ./examples/linear-accelerator-sidecar.sh",
    "classifier:linear:sidecar": "sh ./examples/linear-local-classifier-sidecar.sh",
    "classifier:linear:evidence": "PROOFROUTE_CLASSIFIER_URL=http://127.0.0.1:8788/classify PROOFROUTE_CLASSIFIER_TIMEOUT_MS=500 PROOFROUTE_ACCELERATOR_MODEL=examples/linear-intent-model.json node ./bin/proofroute.js classifier --bench --warmup --runs 3 --max-p95-ms 50 --min-accuracy 0.8 --min-throughput 1 --min-devices 1 --min-lanes 1 --require-device-profiles --evidence --json --out classifier-linear-evidence.json",
    "classifier:linear:verify": "node ./bin/proofroute.js classifier --verify-evidence classifier-linear-evidence.json --max-evidence-age-hours 24",
    "classifier:onnx": "sh ./examples/onnx-accelerator-sidecar.sh",
    "classifier:tensorrt": "sh ./examples/tensorrt-accelerator-sidecar.sh",
    "classifier:svg": "node ./bin/proofroute.js classifier --warmup --svg --out docs/proofroute-classifier.svg",
    "classifier:bench:svg": "node ./bin/proofroute.js classifier --bench --warmup --min-devices 2 --min-lanes 2 --require-device-profiles --svg --out docs/proofroute-classifier-benchmark.svg",
    "classifier:artifact:evidence": "PROOFROUTE_CLASSIFIER=\"node ./examples/linear-classifier-command.js\" PROOFROUTE_CLASSIFIER_TIMEOUT_MS=1000 PROOFROUTE_ACCELERATOR_MODEL=examples/linear-intent-model.json node ./bin/proofroute.js classifier --bench --runs 1 --max-p95-ms 200 --min-accuracy 0.8 --evidence --json --out classifier-linear-evidence.json",
    "classifier:artifact:verify": "node ./bin/proofroute.js classifier --verify-evidence classifier-linear-evidence.json --allow-artifact-only --max-evidence-age-hours 24",
    "classifier:evidence": "node ./bin/proofroute.js classifier --bench --warmup --min-devices 2 --min-lanes 2 --require-device-profiles --evidence --json --out classifier-evidence.json",
    "classifier:hardware:evidence": "node ./bin/proofroute.js classifier --bench --warmup --min-devices 2 --min-lanes 2 --require-device-profiles --require-hardware-probe --evidence --json --out classifier-evidence.json",
    "classifier:hardware:verify": "node ./bin/proofroute.js classifier --verify-evidence classifier-evidence.json --require-hardware-probe --max-evidence-age-hours 24",
    "classifier:verify": "node ./bin/proofroute.js classifier --verify-evidence classifier-evidence.json --max-evidence-age-hours 24",
    "export:onnx": "node ./examples/export-linear-intent-onnx.js --model examples/linear-intent-model.json --out examples/linear-intent-model.onnx",
    "train:intent": "node ./bin/proofroute.js learn --samples examples/samples.json --model examples/linear-intent-model.json --out examples/linear-intent-model.trained.json --onnx-out examples/linear-intent-model.trained.onnx",
    "test": "node --test",
    "check": "find bin src test examples scripts -name '*.js' -print -exec node --check {} \\;",
    "check:shell": "find examples scripts -name '*.sh' -print -exec sh -n {} \\;",
    "check:prose": "node ./scripts/check-prose-docs.js README.md docs CONTRIBUTING.md SECURITY.md .github/PULL_REQUEST_TEMPLATE.md .github/ISSUE_TEMPLATE src bin examples test package.json LICENSE .env.example"
  },
  "keywords": [
    "llm",
    "ai-router",
    "ai-gateway",
    "inference-router",
    "llm-router",
    "llm-proxy",
    "llm-gateway",
    "model-gateway",
    "model-router",
    "model-routing",
    "model-selection",
    "prompt-router",
    "prompt-routing",
    "router",
    "routing-engine",
    "proxy",
    "openai",
    "openai-compatible",
    "openai-proxy",
    "transparent-proxy",
    "ollama",
    "lm-studio",
    "vllm",
    "cuda",
    "tensorrt",
    "onnx",
    "onnxruntime",
    "local-llm",
    "local-first",
    "privacy-preserving",
    "prompt-privacy",
    "multi-gpu",
    "gpu-classifier",
    "gpu-routing",
    "terminal-ui",
    "cost-optimization",
    "cost-savings",
    "llmops",
    "agentic",
    "agent-router",
    "coding-agent",
    "developer-tools",
    "cli",
    "avc",
    "vibe-coding"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
